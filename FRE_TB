`timescale 1ns / 1ps

module tb_repellant_generator;

    reg clk;
    reg rst_n;

    reg btn_onoff;
    reg btn_mode;
    reg btn_inc;
    reg btn_dec;

    wire signal_out;


    // ========================================================================
    // DUT
    // ========================================================================
    //
    // 10,000 cycles is used only for simulation.
    //
    // 100 MHz clock:
    // 10,000 cycles = 100 us
    //
    // This lets us see ON/OFF operation quickly.
    //
    // ========================================================================

    repellant_generator #(
        .ONOFF_DELAY_CYCLES(32'd10000)
    )
    uut (

        .clk        (clk),
        .rst_n      (rst_n),

        .btn_onoff  (btn_onoff),
        .btn_mode   (btn_mode),
        .btn_inc    (btn_inc),
        .btn_dec    (btn_dec),

        .signal_out (signal_out)

    );


    // ========================================================================
    // 100 MHz CLOCK
    // ========================================================================

    always #5 clk = ~clk;


    // ========================================================================
    // TEST
    // ========================================================================

    initial begin

        // ------------------------------------------------------------
        // INITIAL VALUES
        // ------------------------------------------------------------

        clk = 1'b0;

        rst_n = 1'b0;

        btn_onoff = 1'b1;
        btn_mode  = 1'b1;
        btn_inc   = 1'b1;
        btn_dec   = 1'b1;


        // ------------------------------------------------------------
        // RESET
        // ------------------------------------------------------------

        #100;

        rst_n = 1'b1;


        // ============================================================
        // PRESS ON/OFF
        // ============================================================
        //
        // Press button
        // Wait for simulated 10-second delay
        // Generator becomes ON
        //
        // ============================================================

        #25000000;

        btn_onoff = 1'b0;

        #25000000;

        btn_onoff = 1'b1;


        // Wait for ON delay
        #200000;


        // ============================================================
        // MODE 1
        // 100 Hz
        // ============================================================

        btn_mode = 1'b0;

        #25000000;

        btn_mode = 1'b1;


        // ============================================================
        // MODE 1: +100 three times
        // ============================================================

        #25000000;

        btn_inc = 1'b0;
        #25000000;
        btn_inc = 1'b1;

        #25000000;

        btn_inc = 1'b0;
        #25000000;
        btn_inc = 1'b1;

        #25000000;

        btn_inc = 1'b0;
        #25000000;
        btn_inc = 1'b1;


        // ============================================================
        // MODE 2
        // 1 kHz
        // ============================================================

        #25000000;

        btn_mode = 1'b0;
        #25000000;
        btn_mode = 1'b1;


        // MODE 2 +100
        #25000000;

        btn_inc = 1'b0;
        #25000000;
        btn_inc = 1'b1;


        // MODE 2 -100
        #25000000;

        btn_dec = 1'b0;
        #25000000;
        btn_dec = 1'b1;


        // ============================================================
        // MODE 3
        // 10 kHz
        // ============================================================

        #25000000;

        btn_mode = 1'b0;
        #25000000;
        btn_mode = 1'b1;


        // MODE 3 +100
        #25000000;

        btn_inc = 1'b0;
        #25000000;
        btn_inc = 1'b1;


        // MODE 3 -100
        #25000000;

        btn_dec = 1'b0;
        #25000000;
        btn_dec = 1'b1;


        // ============================================================
        // PRESS ON/OFF AGAIN
        // ============================================================
        //
        // Press
        // Wait simulated 10 seconds
        // Generator becomes OFF
        //
        // ============================================================

        #25000000;

        btn_onoff = 1'b0;

        #25000000;

        btn_onoff = 1'b1;


        // Wait for OFF delay
        #200000;


        // ============================================================
        // END SIMULATION
        // ============================================================

        #100000;

        $finish;

    end


    // ========================================================================
    // WAVEFORM
    // ========================================================================

    initial begin

        $dumpfile("waveform.vcd");

        $dumpvars(0, tb_repellant_generator);

    end

endmodule
